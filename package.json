{
  "name": "traco-tattoo-studio",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/logic.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "export:standalone": "npm run build && node scripts/export-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "build:server": "npm run typecheck && vite build --base=/ --mode booking",
    "test:booking": "node --test tests/booking.test.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
